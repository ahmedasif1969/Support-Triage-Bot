# This whole project folder is delivered as one self-contained copy per
# client — copy the folder, fill in this file (as .env) and config.json
# with that client's own details, and hand them the folder to host.
#
# Secrets only — never commit .env. Non-secret settings (business name,
# taxonomy, inbox type, etc.) live in config.json instead.

GEMINI_API_KEY=your-google-ai-studio-key-here
SLACK_WEBHOOK_URL=

# Your own ops channel — where YOU get paged if this client's bot breaks,
# separate from their SLACK_WEBHOOK_URL above. Optional: if you're
# delivering this folder to the client to host themselves, leave it blank
# or point it at whatever channel you use to keep tabs on client bots.
OPS_SLACK_WEBHOOK_URL=
