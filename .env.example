# ==============================================================================
# Support Triage Bot - Environment Secrets Template
#
# DO NOT COMMIT .env TO GIT.
# When deploying on Railway, add these under: Project -> Variables -> Secrets.
# ==============================================================================

# --- AI Model ---
GEMINI_API_KEY=your-google-ai-studio-key-here

# --- Slack Notifications ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
OPS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Gmail Connector (OAuth App Credentials) ---
# Downloaded from Google Cloud Console (OAuth Client ID - Desktop App)
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REDIRECT_URI=http://localhost

# --- Google Sheets Connector ---
# Full JSON contents of the Service Account key file (for headless hosting)
SHEETS_SERVICE_ACCOUNT=

# --- Persistent Paths / Pre-seeded Tokens (Headless Railway Deployments) ---
# GMAIL_TOKEN_JSON= # Paste contents of token.json if pre-authorizing locally
# GMAIL_TOKEN_PATH=/railway/data/token.json
# STATE_DB_PATH=/railway/data/state.db
# TICKETS_LOG=/railway/data/tickets_log.csv
